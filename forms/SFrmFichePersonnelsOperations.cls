Private Sub TxtPerSocOpeTypCode_DblClick(Cancel As Integer)
   Dim IntEtat As Integer

   On Error GoTo Err_TxtPerSocOpeTypCode_DblClick

   DonneEtatFormulaire "FrmSaisiesOperationsTypes", IntEtat

   Select Case IntEtat
      Case VUEFORMULAIRE

         Forms!FrmSaisiesOperationsTypes.SetFocus

         DoCmd.ApplyFilter , "PerSocOpeNum=" & PerSocOpeNum

         DoCmd.RunCommand acCmdWindowCascade

      Case Else

         DoCmd.OpenForm "FrmSaisiesOperationsTypes", acNormal, , "PerSocOpeNum=" & PerSocOpeNum, acFormEdit

   End Select

Exit_TxtPerSocOpeTypCode_DblClick:

   Exit Sub

Err_TxtPerSocOpeTypCode_DblClick:

   MsgBox Err.Number & " " & Err.Description, vbCritical, "TxtPerSocOpeTypCode_DblClick"

   Resume Exit_TxtPerSocOpeTypCode_DblClick
End Sub

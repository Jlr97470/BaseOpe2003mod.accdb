Option Explicit

'******************************************************************************
'***    EVENEMENT:                                                                                    ***
'******************************************************************************

'******************************************************************************
'***    EVENEMENT:                                                                                    ***
'******************************************************************************
'***    FONCTION:                                                                                       ***
'******************************************************************************
'***    ENTREE:                                                                                           ***
'***    SORTIE:                                                                                            ***
'******************************************************************************
Private Sub Form_Load()

   On Error GoTo Err_Form_Load

   Set GEtiTitTraitements = EtiTitValeur

   Set GEtiFonTraitements = EtiFonValeur

   Set GEtiObjTraitements = EtiObjValeur

   Set GPbrTraitements = PbrGestionTraitements

Exit_Form_Load:

   Exit Sub

Err_Form_Load:

   MsgBox Err.Number & " " & Err.Description, vbCritical, "Form_Load"

   Resume Exit_Form_Load
End Sub

'******************************************************************************
'***    EVENEMENT:                                                                                    ***
'******************************************************************************
'***    FONCTION:                                                                                       ***
'******************************************************************************
'***    ENTREE:                                                                                           ***
'***    SORTIE:                                                                                            ***
'******************************************************************************
Private Sub Form_Unload(Cancel As Integer)

   On Error GoTo Err_Form_Unload

   Set GEtiTitTraitements = Nothing

   Set GEtiFonTraitements = Nothing

   Set GEtiObjTraitements = Nothing

   Set GPbrTraitements = Nothing

Exit_Form_Unload:

   Exit Sub

Err_Form_Unload:

   MsgBox Err.Number & " " & Err.Description, vbCritical, "Form_Unload"

   Resume Exit_Form_Unload
End Sub

Private Sub Form_Load()

   On Error GoTo Err_Form_Load

   DoCmd.RunCommand acCmdWindowCascade

Exit_Form_Load:

   Exit Sub

Err_Form_Load:

   MsgBox Err.Number & " " & Err.Description, vbCritical, "Form_Load"

   Resume Err_Form_Load
End Sub

'******************************************************************************
'***    EVENEMENT:                                                                                    ***
'******************************************************************************
'***    FONCTION:                                                                                       ***
'******************************************************************************
'***    ENTREE:                                                                                           ***
'***    SORTIE:                                                                                            ***
'******************************************************************************
Private Sub Form_BeforeUpdate(Cancel As Integer)

    On Error GoTo Err_Form_BeforeUpdate

    Select Case IsNull(CivCode)
      Case True

         Cancel = True

         MsgBox "Le Champ Civilité Code Est Obligatoire !", , Me.Caption

         TxtCivCode.SetFocus

         GoTo Exit_Form_BeforeUpdate
      Case False

   End Select

    Select Case IsNull(CivLibelle)
      Case True

         Cancel = True

         MsgBox "Le Champ Civilité Libelle Est Obligatoire !", , Me.Caption

         TxtCivLibelle.SetFocus

         GoTo Exit_Form_BeforeUpdate
      Case False

   End Select

   TxtCivCode = StrConv(TxtCivCode, vbProperCase)

   TxtCivLibelle = StrConv(TxtCivLibelle, vbProperCase)

Exit_Form_BeforeUpdate:

    Exit Sub

Err_Form_BeforeUpdate:

    MsgBox Err.Number & " " & Err.Description, vbCritical, "Form_BeforeUpdate"
End Sub

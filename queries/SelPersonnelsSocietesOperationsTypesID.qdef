dbMemo "SQL" ="SELECT TBLPERSONNELSSOCIETESOPERATIONS.PerSocOpePerSocNum, TBLPERSONNELSSOCIETES"
    "OPERATIONSTYPESID.*\015\012FROM TBLPERSONNELSSOCIETESOPERATIONSTYPESID INNER JOI"
    "N TBLPERSONNELSSOCIETESOPERATIONS ON TBLPERSONNELSSOCIETESOPERATIONSTYPESID.PerS"
    "ocOpeTypIDPerSocOpeTypNum = TBLPERSONNELSSOCIETESOPERATIONS.PerSocOpePerSocOpeTy"
    "pNum;\015\012"
dbMemo "Connect" =""
dbBoolean "ReturnsRecords" ="-1"
dbInteger "ODBCTimeout" ="0"
dbByte "RecordsetType" ="0"
dbBoolean "OrderByOn" ="0"
dbByte "Orientation" ="0"
dbByte "DefaultView" ="2"
dbText "Description" ="Selection Des Operations Types ID Des Personnels Par Societes\015\012"

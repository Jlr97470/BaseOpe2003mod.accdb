dbMemo "SQL" ="TRANSFORM First(PerSocQstResValeur) AS PerSocQstResValeurValeur\015\012SELECT Pe"
    "rSocQstNum, PerSocQstPerSocQstTypNum, PerSocQstPerSocNum, PerSocQstDateSaisie, P"
    "erSocQstNotes\015\012FROM ((TBLPERSONNELSSOCIETESQUESTIONNAIRESTYPES INNER JOIN "
    "TBLPERSONNELSSOCIETESQUESTIONNAIRESTYPESID ON TBLPERSONNELSSOCIETESQUESTIONNAIRE"
    "STYPES.PerSocQstTypNum = TBLPERSONNELSSOCIETESQUESTIONNAIRESTYPESID.PerSocQstTyp"
    "IDPerSocQstTypNum) INNER JOIN TBLPERSONNELSSOCIETESQUESTIONNAIRESRESULTATS ON TB"
    "LPERSONNELSSOCIETESQUESTIONNAIRESTYPESID.PerSocQstTypIDNum = TBLPERSONNELSSOCIET"
    "ESQUESTIONNAIRESRESULTATS.PerSocQstResPerSocQstTypIDNum) INNER JOIN TBLPERSONNEL"
    "SSOCIETESQUESTIONNAIRES ON (TBLPERSONNELSSOCIETESQUESTIONNAIRESTYPES.PerSocQstTy"
    "pNum = TBLPERSONNELSSOCIETESQUESTIONNAIRES.PerSocQstPerSocQstTypNum) AND (TBLPER"
    "SONNELSSOCIETESQUESTIONNAIRESRESULTATS.PerSocQstResPerSocNum = TBLPERSONNELSSOCI"
    "ETESQUESTIONNAIRES.PerSocQstPerSocNum)\015\012WHERE TBLPERSONNELSSOCIETESQUESTIO"
    "NNAIRESTYPES.PerSocQstTypNum = 2\015\012GROUP BY PerSocQstNum, PerSocQstPerSocQs"
    "tTypNum, PerSocQstPerSocNum, PerSocQstDateSaisie, PerSocQstNotes, PerSocQstTypCo"
    "de, PerSocQstTypLibelle, PerSocQstTypDateDebut, PerSocQstTypDateFin, PerSocQstTy"
    "pNbResultat\015\012PIVOT 'PerSocQstResValeur' & [PerSocQstTypID] In ('PerSocQstR"
    "esValeur1','PerSocQstResValeur2','PerSocQstResValeur3','PerSocQstResValeur4','Pe"
    "rSocQstResValeur5','PerSocQstResValeur6','PerSocQstResValeur7','PerSocQstResVale"
    "ur8','PerSocQstResValeur9','PerSocQstResValeur10','PerSocQstResValeur11','PerSoc"
    "QstResValeur12','PerSocQstResValeur13');\015\012"
dbMemo "Connect" =""
dbBoolean "ReturnsRecords" ="-1"
dbInteger "ODBCTimeout" ="60"
Begin
End

dbMemo "SQL" ="SELECT TBLPERSONNELSSOCIETES.*, TBLPERSONNELSSOCIETESOPERATIONS.*, TBLPERSONNELS"
    "SOCIETESOPERATIONSTYPES.*, TBLPERSONNELSSOCIETESOPERATIONSRESULTATS.*\015\012FRO"
    "M TBLPERSONNELSSOCIETESOPERATIONSTYPES INNER JOIN (TBLPERSONNELSSOCIETES INNER J"
    "OIN (TBLPERSONNELSSOCIETESOPERATIONSRESULTATS INNER JOIN TBLPERSONNELSSOCIETESOP"
    "ERATIONS ON TBLPERSONNELSSOCIETESOPERATIONSRESULTATS.PerSocOpeResPerSocNum=TBLPE"
    "RSONNELSSOCIETESOPERATIONS.PerSocOpePerSocNum) ON (TBLPERSONNELSSOCIETES.PerSocN"
    "um=TBLPERSONNELSSOCIETESOPERATIONS.PerSocOpePerSocNum) AND (TBLPERSONNELSSOCIETE"
    "S.PerSocNum=TBLPERSONNELSSOCIETESOPERATIONSRESULTATS.PerSocOpeResPerSocNum)) ON "
    "TBLPERSONNELSSOCIETESOPERATIONSTYPES.PerSocOpeTypNum=TBLPERSONNELSSOCIETESOPERAT"
    "IONS.PerSocOpePerSocOpeTypNum;\015\012"
dbMemo "Connect" =""
dbBoolean "ReturnsRecords" ="-1"
dbInteger "ODBCTimeout" ="60"
dbText "Description" ="Selection Des Operations, Operations Types, Operations Resultats Des Personnels "
    "Par Societes\015\012\015\012"
dbBoolean "OrderByOn" ="0"
dbByte "Orientation" ="0"
dbByte "DefaultView" ="2"
Begin
End
